{
  "name": "echosift-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "plasmo dev --src-path=.",
    "build": "plasmo build --src-path=.",
    "package": "plasmo package --src-path=."
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3"
  },
  "manifest": {
    "manifest_version": 3,
    "name": "EchoSift 评论分析",
    "version": "0.1.0",
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://www.producthunt.com/products/*",
      "https://apps.apple.com/*",
      "https://play.google.com/*",
      "https://echosift.online/*"
    ]
  }
}
